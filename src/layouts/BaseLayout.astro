---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FontSwitcher from "../components/FontSwitcher.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import { site } from "../data/site";
import "../styles/global.css";
import "../styles/themes.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = `${site.name} | Chemical Engineering, NIT Srinagar`,
  description = site.description,
  ogImage = `${site.canonical}/images/fatima-jalid-social.jpg`,
  structuredData,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, site.canonical);

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: site.canonical,
  image: `${site.canonical}${site.portrait}`,
  jobTitle: site.role,
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: site.institute,
  },
  email: site.email,
  sameAs: [site.links.linkedin, site.links.nitProfile, site.links.scholar, site.links.orcid, site.links.blog],
};

// Auto breadcrumb (Home > Section) for non-home pages.
const segments = Astro.url.pathname.replace(/\/$/, "").split("/").filter(Boolean);
const breadcrumbJsonLd = segments.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.canonical },
        ...segments.map((segment, index) => ({
          "@type": "ListItem",
          position: index + 2,
          name: segment.charAt(0).toUpperCase() + segment.slice(1),
          item: `${site.canonical}/${segments.slice(0, index + 1).join("/")}`,
        })),
      ],
    }
  : null;

const jsonLdBlocks = [
  personJsonLd,
  ...(breadcrumbJsonLd ? [breadcrumbJsonLd] : []),
  ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Enable scroll-reveal only when JS is on AND motion is welcome.
      // Without this class, all content renders fully visible (no-JS / reduced-motion safe).
      try {
        if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
          document.documentElement.classList.add("reveal-on");
        }
      } catch (e) {}
    </script>
    {import.meta.env.DEV && (
      <script is:inline>
        // Dev-only: apply the saved design direction before paint (no flash).
        try {
          var t = localStorage.getItem("dev-theme");
          if (t) document.documentElement.dataset.theme = t;
        } catch (e) {}
      </script>
    )}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&family=Space+Grotesk:wght@500;600;700&family=Space+Mono:wght@400;700&family=Noto+Nastaliq+Urdu:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    {import.meta.env.DEV && <FontSwitcher />}
    {import.meta.env.DEV && <ThemeSwitcher />}
    <script is:inline>
      (function () {
        if (!document.documentElement.classList.contains("reveal-on")) return;
        var targets = document.querySelectorAll("main > section");
        if (!("IntersectionObserver" in window)) {
          targets.forEach(function (el) { el.classList.add("is-visible"); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        targets.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
