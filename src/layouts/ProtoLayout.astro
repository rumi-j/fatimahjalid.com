---
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  variant: "molecular" | "mihrab";
}

const { title, description, variant } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, site.canonical);
const protoLabel = variant === "molecular" ? "Molecular Interface" : "Deep Mihrab";
---

<!doctype html>
<html lang="en" data-proto={variant}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&family=Space+Grotesk:wght@500;600;700&family=Space+Mono:wght@400;700&family=Noto+Nastaliq+Urdu:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
          document.documentElement.classList.add("reveal-on");
        }
      } catch (e) {}
    </script>
    <title>{title}</title>
  </head>
  <body class={`proto-shell proto-${variant}`}>
    <a class="proto-skip" href="#main">Skip to content</a>
    <div class="proto-banner">
      <span>Design prototype</span>
      <strong>{protoLabel}</strong>
      <span>Not production</span>
    </div>
    <header class="proto-header" aria-label={`${protoLabel} prototype header`}>
      <a class="proto-brand" href="/">
        <span>FJ</span>
        <strong>{site.brand}</strong>
      </a>
      <nav aria-label="Prototype navigation">
        <a href="/">Editorial home</a>
        <a href="/research">Research</a>
        <a href="/publications">Publications</a>
        <a href="/teaching">Teaching</a>
        <a href="/personal">Personal</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="proto-footer" id="contact">
      <p>{site.name}</p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <div>
        <a href={site.links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        <a href={site.links.nitProfile} target="_blank" rel="noreferrer">NIT profile</a>
        <a href={site.links.scholar} target="_blank" rel="noreferrer">Scholar</a>
        <a href={site.links.blog} target="_blank" rel="noreferrer">Blog</a>
      </div>
    </footer>
    <script is:inline>
      (function () {
        if (!document.documentElement.classList.contains("reveal-on")) return;
        var targets = document.querySelectorAll("[data-reveal]");
        if (!("IntersectionObserver" in window)) {
          targets.forEach(function (el) { el.classList.add("is-visible"); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        targets.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --proto-font-sans: "DM Sans", system-ui, sans-serif;
    --proto-font-display: "Space Grotesk", "DM Sans", system-ui, sans-serif;
    --proto-font-mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --proto-font-serif: "DM Serif Display", Georgia, serif;
    --proto-font-urdu: "Noto Nastaliq Urdu", serif;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body.proto-shell {
    min-width: 320px;
    margin: 0;
    font-family: var(--proto-font-sans);
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }
  body.proto-molecular {
    --proto-bg: #070b0e;
    --proto-panel: rgba(13, 20, 25, 0.82);
    --proto-panel-strong: rgba(17, 28, 34, 0.94);
    --proto-line: rgba(139, 232, 221, 0.18);
    --proto-text: #eef8f6;
    --proto-muted: #8aa09e;
    --proto-copper: #c98253;
    --proto-teal: #59d9cd;
    --proto-green: #8dd784;
    background:
      radial-gradient(circle at 18% 8%, rgba(89, 217, 205, 0.13), transparent 30rem),
      radial-gradient(circle at 86% 16%, rgba(201, 130, 83, 0.12), transparent 28rem),
      linear-gradient(180deg, #071013 0%, #05070a 72%);
    color: var(--proto-text);
  }
  body.proto-mihrab {
    --proto-bg: #f7eedc;
    --proto-panel: rgba(255, 250, 239, 0.84);
    --proto-panel-strong: #fff8eb;
    --proto-line: rgba(48, 74, 64, 0.18);
    --proto-text: #173b32;
    --proto-muted: #61786e;
    --proto-gold: #ba8f2d;
    --proto-lapis: #1d506c;
    --proto-rust: #aa6047;
    background:
      radial-gradient(circle at 16% 0%, rgba(186, 143, 45, 0.17), transparent 24rem),
      radial-gradient(circle at 90% 22%, rgba(29, 80, 108, 0.12), transparent 26rem),
      var(--proto-bg);
    color: var(--proto-text);
  }
  body.proto-shell a { color: inherit; text-decoration: none; }
  body.proto-shell a:hover { text-decoration: underline; text-underline-offset: 0.28em; }

  .proto-skip {
    position: fixed;
    z-index: 999;
    top: 12px;
    left: 12px;
    transform: translateY(-180%);
    padding: 10px 14px;
    border-radius: 999px;
    background: var(--proto-text);
    color: var(--proto-bg) !important;
    font-family: var(--proto-font-mono);
    font-size: 0.72rem;
  }
  .proto-skip:focus { transform: translateY(0); }
  .proto-banner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    padding: 8px 16px;
    border-bottom: 1px solid var(--proto-line);
    color: var(--proto-muted);
    font-family: var(--proto-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .proto-banner strong { color: var(--proto-text); font-weight: 700; }
  .proto-header {
    position: sticky;
    z-index: 20;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px clamp(18px, 4vw, 64px);
    border-bottom: 1px solid var(--proto-line);
    backdrop-filter: blur(18px);
  }
  .proto-molecular .proto-header {
    background: rgba(7, 11, 14, 0.74);
  }
  .proto-mihrab .proto-header {
    background: rgba(247, 238, 220, 0.78);
  }
  .proto-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--proto-font-display);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .proto-brand span {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid var(--proto-line);
    border-radius: 12px;
  }
  .proto-molecular .proto-brand span { color: var(--proto-teal); }
  .proto-mihrab .proto-brand span { color: var(--proto-lapis); border-radius: 999px 999px 8px 8px; }
  .proto-header nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 12px 20px;
    color: var(--proto-muted);
    font-family: var(--proto-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .proto-header nav a:focus-visible,
  .proto-footer a:focus-visible,
  .proto-shell a:focus-visible,
  .proto-shell button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
  .proto-footer {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(180px, 0.8fr) minmax(220px, 1fr);
    gap: 24px;
    padding: 44px clamp(18px, 4vw, 64px);
    border-top: 1px solid var(--proto-line);
    color: var(--proto-muted);
  }
  .proto-footer p {
    margin: 0;
    color: var(--proto-text);
    font-family: var(--proto-font-display);
    font-size: 1.15rem;
  }
  .proto-footer div {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
    font-family: var(--proto-font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }
  [data-reveal] {
    transform: none;
    opacity: 1;
  }
  .reveal-on [data-reveal] {
    transform: translateY(18px);
    opacity: 0;
    transition: transform 700ms ease, opacity 700ms ease;
  }
  .reveal-on [data-reveal].is-visible {
    transform: translateY(0);
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.001ms !important;
    }
  }
  @media (max-width: 820px) {
    .proto-header { align-items: flex-start; flex-direction: column; }
    .proto-header nav { justify-content: flex-start; }
    .proto-footer { grid-template-columns: 1fr; }
  }
</style>
