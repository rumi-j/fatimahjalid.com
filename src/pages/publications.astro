---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import { publications, publicationStats, type Publication } from "../data/publications";
import { site } from "../data/site";
import { bibtex, checkPublications, citation, formatDetails, referenceUrl, searchText } from "../lib/citations";

// Fails the build on a duplicate or missing key, or an incomplete journal entry.
checkPublications(publications);

const labels = { journal: "Journal article", chapter: "Book chapter", patent: "Patent" };

const sorted = [...publications].sort((a, b) => b.year - a.year);

const allTags = [...new Set(publications.flatMap((p) => p.tags ?? []))].sort();
// Tag values stay as stored (data-topic, data-tags); only the button text changes.
const topicLabel: Record<string, string> = { CO2: "CO₂" };

type Group = { year: number; items: Publication[] };
const groups: Group[] = [];
for (const item of sorted) {
  const group = groups.find((g) => g.year === item.year);
  if (group) group.items.push(item);
  else groups.push({ year: item.year, items: [item] });
}

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Publications by Fatima Jalid",
  itemListElement: sorted.map((p, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": p.type === "journal" ? "ScholarlyArticle" : "CreativeWork",
      name: p.title,
      headline: p.title,
      datePublished: String(p.year),
      author: p.authors.split(/,\s*/).map((name) => ({ "@type": "Person", name })),
      isPartOf: p.venue,
      ...(referenceUrl(p) ? { url: referenceUrl(p) } : {}),
    },
  })),
};
---

<BaseLayout
  title="Publications | Fatima Jalid"
  description="Peer-reviewed publications, book chapters, and granted patent from Fatima Jalid."
  structuredData={structuredData}
>
  <PageIntro
    eyebrow="Publications"
    folio="04"
    title="A growing record of inquiry."
    intro="Peer-reviewed journal articles, book chapters, and granted intellectual property. Search the record, filter by type or topic, and copy a citation for any entry."
  />

  <section class="section-shell publication-stats">
    {publicationStats.map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}
    <div class="profile-links">
      <a href={site.links.scholar} target="_blank" rel="noreferrer">Google Scholar ↗</a>
      <a href={site.links.orcid} target="_blank" rel="noreferrer">ORCID ↗</a>
    </div>
  </section>

  <section class="section-shell publication-section">
    <div class="pub-controls">
      <label class="pub-search-field">
        <span class="sr-only">Search publications</span>
        <input class="pub-search" type="search" placeholder="Search by title, author, or venue…" autocomplete="off" />
      </label>
      <div class="filter-row" role="group" aria-label="Filter by type">
        <button class="filter active" type="button" aria-pressed="true" data-filter="all">All</button>
        <button class="filter" type="button" aria-pressed="false" data-filter="journal">Journal articles</button>
        <button class="filter" type="button" aria-pressed="false" data-filter="chapter">Book chapters</button>
        <button class="filter" type="button" aria-pressed="false" data-filter="patent">Patent</button>
      </div>
      <div class="topic-row" role="group" aria-label="Filter by topic">
        {allTags.map((tag) => (
          <button class="topic" type="button" aria-pressed="false" data-topic={tag}>{topicLabel[tag] ?? tag}</button>
        ))}
      </div>
    </div>

    <p class="result-count" aria-live="polite">{publications.length} records</p>
    <div class="pub-empty" hidden>
      <p>No records match these filters.</p>
      <button class="pub-clear" type="button">Clear filters</button>
    </div>

    <div class="publication-list">
      {groups.map((group) => (
        <div class="pub-year-group" data-year={group.year}>
          <h2 class="pub-year">{group.year}</h2>
          <div class="pub-year-items">
            {group.items.map((item) => (
              <article
                id={item.key}
                class="publication-item"
                data-type={item.type}
                data-tags={(item.tags ?? []).join(",")}
                data-text={searchText(item)}
              >
                <p class="publication-meta">{labels[item.type]}{item.note ? ` · ${item.note}` : ""}</p>
                <h3>{item.title}</h3>
                <p class="authors">{item.authors}</p>
                <p>{item.venue}{formatDetails(item) && ` · ${formatDetails(item)}`}</p>
                <div class="pub-actions">
                  {referenceUrl(item) && (
                    <a class="text-link" href={referenceUrl(item)} target="_blank" rel="noreferrer">Open reference <span>↗</span></a>
                  )}
                  <button class="cite-button" type="button" data-copy="citation">Copy citation</button>
                  {item.key && <button class="cite-button" type="button" data-copy="bibtex">BibTeX</button>}
                </div>
                <span class="cite-citation" hidden>{citation(item)}</span>
                {item.key && <span class="cite-bibtex" hidden>{bibtex(item)}</span>}
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <script>
    import { bindCopyButtons, foldSubscripts } from "../lib/citations";

    const root = document.querySelector<HTMLElement>(".publication-section");
    if (root) {
      const search = root.querySelector<HTMLInputElement>(".pub-search");
      const typeButtons = root.querySelectorAll<HTMLButtonElement>(".filter-row .filter");
      const topicButtons = root.querySelectorAll<HTMLButtonElement>(".topic-row .topic");
      const items = root.querySelectorAll<HTMLElement>(".publication-item");
      const groupEls = root.querySelectorAll<HTMLElement>(".pub-year-group");
      const count = root.querySelector<HTMLElement>(".result-count");
      const empty = root.querySelector<HTMLElement>(".pub-empty");
      const clear = root.querySelector<HTMLButtonElement>(".pub-clear");

      let typeFilter = "all";
      const activeTopics = new Set<string>();

      const apply = () => {
        const query = foldSubscripts(search?.value ?? "").trim().toLowerCase();
        let visible = 0;
        items.forEach((item) => {
          const type = item.dataset.type ?? "";
          const tags = (item.dataset.tags ?? "").split(",").filter(Boolean);
          const text = item.dataset.text ?? "";
          const okType = typeFilter === "all" || type === typeFilter;
          const okTopic = activeTopics.size === 0 || tags.some((t) => activeTopics.has(t));
          const okSearch = query === "" || text.includes(query);
          const show = okType && okTopic && okSearch;
          item.hidden = !show;
          if (show) visible += 1;
        });
        groupEls.forEach((group) => {
          group.hidden = !group.querySelector(".publication-item:not([hidden])");
        });
        if (count) count.textContent = `${visible} ${visible === 1 ? "record" : "records"}`;
        if (empty) empty.hidden = visible > 0;
      };

      const setType = (value: string) => {
        typeFilter = value;
        typeButtons.forEach((other) => {
          const on = other.dataset.filter === value;
          other.classList.toggle("active", on);
          other.setAttribute("aria-pressed", String(on));
        });
      };

      typeButtons.forEach((button) =>
        button.addEventListener("click", () => {
          setType(button.dataset.filter ?? "all");
          apply();
        }),
      );

      topicButtons.forEach((button) =>
        button.addEventListener("click", () => {
          const topic = button.dataset.topic ?? "";
          if (activeTopics.has(topic)) activeTopics.delete(topic);
          else activeTopics.add(topic);
          const pressed = button.classList.toggle("active");
          button.setAttribute("aria-pressed", String(pressed));
          apply();
        }),
      );

      search?.addEventListener("input", apply);

      // Reset the search, the type filter and the topics. The button hides
      // itself, so focus moves to the search field.
      clear?.addEventListener("click", () => {
        if (search) search.value = "";
        setType("all");
        activeTopics.clear();
        topicButtons.forEach((button) => {
          button.classList.remove("active");
          button.setAttribute("aria-pressed", "false");
        });
        apply();
        search?.focus();
      });

      bindCopyButtons(root);
    }
  </script>
</BaseLayout>
