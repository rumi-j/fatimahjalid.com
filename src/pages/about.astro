---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import ArchFrame from "../components/girih/ArchFrame.astro";
import { about } from "../data/about";
import { education, memberships } from "../data/professional";
import { site } from "../data/site";
import portrait from "../assets/fatima-jalid-portrait.jpg";
---

<BaseLayout
  title="About | Fatima Jalid"
  description="The path, research focus, and guiding ideas of Fatima Jalid, Assistant Professor of Chemical Engineering at NIT Srinagar."
>
  <PageIntro eyebrow="About" folio="02" title="On the path of learning." intro={about.lede} />

  <section class="section-shell about-split">
    <figure class="about-portrait">
      <ArchFrame>
        <Picture
          src={portrait}
          formats={["avif", "webp"]}
          widths={[360, 540, 820]}
          sizes="(max-width: 760px) 80vw, 34vw"
          alt="Portrait of Fatima Jalid"
        />
      </ArchFrame>
    </figure>
    <div class="prose drop-cap">
      {about.narrative.map((paragraph) => <p>{paragraph}</p>)}
      <p class="small-note">Also written as {site.alternateName}.</p>
      <a class="text-link" href="/research/">See the research <span>↗</span></a>
    </div>
  </section>

  <section class="section-shell about-principles">
    <h2 class="sr-only">What guides the work</h2>
    <p class="eyebrow" aria-hidden="true">What guides the work</p>
    <div class="hobby-grid">
      {about.principles.map((item) => (
        <article>
          <span>{item.number}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section-shell two-column-details">
    <h2 class="sr-only">Education and at a glance</h2>
    <div>
      <p class="eyebrow">Education</p>
      <div class="illuminated-chain" data-reveal-stagger>
        {education.map((item) => (
          <article class="chain-item">
            <span>{item.years}</span>
            <h3>{item.title}</h3>
            <p>{item.place}</p>
            {item.note && <p class="small-note">{item.note}</p>}
          </article>
        ))}
      </div>
    </div>
    <div>
      <p class="eyebrow">At a glance</p>
      <article class="detail-item">
        <h3>{site.role}</h3>
        <p>{site.department}, {site.institute}</p>
      </article>
      <article class="detail-item">
        <h3>Based in</h3>
        <p>{site.location}</p>
      </article>
      <p class="eyebrow memberships-label">Memberships</p>
      <p>{memberships.join(" · ")}</p>
    </div>
  </section>
</BaseLayout>
