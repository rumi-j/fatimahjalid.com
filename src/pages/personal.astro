---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import VersePanel from "../components/VersePanel.astro";
import GirihMark from "../components/girih/GirihMark.astro";
import { blogPosts, books, hobbies } from "../data/personal";
import { site } from "../data/site";
---

<BaseLayout
  title="Personal | Dr. Fatima Jalid"
  description="Books, Iqbal, writing, photography, and the quieter interests of Dr. Fatima Jalid."
>
  <PageIntro
    eyebrow="Personal"
    folio="06"
    title="A life beyond the lab."
    intro="Research is only one form of attention. This is a small corner for words, books, walks, and the details that make a day feel fully inhabited."
  />

  <section class="iqbal-section">
    <div class="section-shell">
      <div class="section-heading narrow">
        <p class="eyebrow">Iqbal</p>
        <h2>Verses I return to.</h2>
      </div>
      <div class="iqbal-spread" data-reveal-stagger>
        <VersePanel
          title="Phool"
          tone="paper"
          urdu={["صنوبر باغ میں آزاد بھی ہے، پا بہ گل بھی ہے", "انہی پابندیوں میں حاصل آزادی کو تو کر لے"]}
          roman={["Sanobar bagh mein azad bhi hai, pa-ba-gil bhi hai", "Inhi pabandiyon mein hasil-e-azadi ko tu kar le"]}
          source="A favourite couplet · Bang-e-Dra"
          href="https://iqbalurdu.blogspot.com/2011/04/bang-e-dra-155-phool.html"
        />
        <VersePanel
          title="Aik Arzoo"
          urduTitle="ایک آرزو"
          tone="paper"
          urdu={["دنیا کی محفلوں سے اکتا گیا ہوں یا رب", "کیا لطف انجمن کا جب دل ہی بجھ گیا ہو"]}
          roman={["Dunya ki mehfilon se ukta gaya hun ya Rab", "Kya lutf anjuman ka jab dil hi bujh gaya ho"]}
          source="My absolute favourite poem · Bang-e-Dra"
          href="https://iqbalurdu.blogspot.com/2011/03/bang-e-dra-19-aik-arzoo.html"
        />
      </div>
      <p class="iqbal-note">
        A reminder that freedom is not always the absence of constraint; sometimes it is
        something we learn to find within it.
      </p>
    </div>
  </section>

  <section class="section-shell reading-section">
    <div class="section-heading narrow">
      <p class="eyebrow">Reading</p>
      <h2>Books on my shelf.</h2>
    </div>
    <div class="book-shelf" data-reveal-stagger>
      {books.map((book, index) => (
        <article class={`book-spine ${book.tone}`}>
          <span class="spine-no">{String(index + 1).padStart(2, "0")}</span>
          <h3>{book.title}</h3>
          <p>{book.author}</p>
        </article>
      ))}
    </div>
    <div class="shelf-rule" aria-hidden="true"></div>
  </section>

  <section class="writing-section">
    <div class="section-shell">
      <div class="writing-heading">
        <div>
          <p class="eyebrow light">Writing</p>
          <h2>From <em>Peace.</em></h2>
        </div>
        <a class="text-link" href={site.links.blog} target="_blank" rel="noreferrer">Visit my blog <span>↗</span></a>
      </div>
      <div class="writing-grid" data-reveal-stagger>
        {blogPosts.map((post) => (
          <article>
            <span>{post.year}</span>
            <h3>{post.title}</h3>
            <p>{post.summary}</p>
            <a class="text-link" href={post.url} target="_blank" rel="noreferrer">Read the post <span>↗</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell photography-section">
    <div>
      <p class="eyebrow">Photography</p>
      <h2>Things worth noticing.</h2>
      <p>Landscapes, light, and fragments from ordinary days. A gallery will grow here slowly.</p>
    </div>
    <div class="reserved-niche">
      <GirihMark size={30} />
      <span>awaiting light</span>
    </div>
  </section>

  <section class="section-shell hobbies-section">
    <p class="eyebrow">Small rituals</p>
    <div class="hobby-grid" data-reveal-stagger>
      {hobbies.map((hobby) => (
        <article>
          <span>{hobby.number}</span>
          <h3>{hobby.title}</h3>
          <p>{hobby.text}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
