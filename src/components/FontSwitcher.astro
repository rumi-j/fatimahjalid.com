---
// Dev-only display-font comparison switcher.
// Rendered from BaseLayout behind `import.meta.env.DEV`, so it is stripped from
// production builds. Lets us flip the --serif face live to compare candidates.
const fonts = [
  { id: "dm", label: "DM Serif Display", stack: '"DM Serif Display", Georgia, serif' },
  { id: "playfair", label: "Playfair Display", stack: '"Playfair Display", Georgia, serif' },
  { id: "newsreader", label: "Newsreader", stack: '"Newsreader", Georgia, serif' },
];
---

<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;1,6..72,500&display=swap"
/>

<div class="font-switcher" aria-label="Display font preview (dev only)">
  <span>Display font</span>
  {fonts.map((f) => <button type="button" data-id={f.id} data-stack={f.stack}>{f.label}</button>)}
</div>

<style>
  .font-switcher {
    position: fixed;
    z-index: 100;
    bottom: 16px;
    left: 16px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    border-radius: 12px;
    background: rgba(15, 43, 38, 0.92);
    color: #fbf8f0;
    font-family: system-ui, sans-serif;
    font-size: 11px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(8px);
  }
  .font-switcher span { opacity: 0.7; letter-spacing: 0.08em; text-transform: uppercase; }
  .font-switcher button {
    padding: 5px 9px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
  }
  .font-switcher button.active { background: #deb75d; border-color: #deb75d; color: #173b32; }
</style>

<script>
  const KEY = "dev-serif";
  const root = document.documentElement;
  const btns = document.querySelectorAll<HTMLButtonElement>(".font-switcher button");

  const apply = (id: string, stack: string | null) => {
    if (stack) root.style.setProperty("--serif", stack);
    else root.style.removeProperty("--serif");
    btns.forEach((b) => b.classList.toggle("active", b.dataset.id === id));
    localStorage.setItem(KEY, id);
  };

  btns.forEach((b) =>
    b.addEventListener("click", () => apply(b.dataset.id ?? "dm", b.dataset.stack ?? null)),
  );

  const saved = localStorage.getItem(KEY) ?? "dm";
  const match = Array.from(btns).find((b) => b.dataset.id === saved) ?? btns[0];
  // "dm" is the CSS default, so only override --serif for the other two.
  apply(saved, saved === "dm" ? null : match?.dataset.stack ?? null);
</script>
