---
import { Picture } from "astro:assets";
import { researchAreas } from "../../data/research";
import { publications, publicationStats } from "../../data/publications";
import { news } from "../../data/news";
import { courses } from "../../data/teaching";
import { books, hobbies } from "../../data/personal";
import { site } from "../../data/site";
import portrait from "../../assets/fatima-jalid-portrait.jpg";

const latestPaper = [...publications]
  .filter((item) => item.type === "journal")
  .sort((a, b) => b.year - a.year)[0];
const recentNews = [...news].sort((a, b) => b.year - a.year).slice(0, 4);
const teachingModules = courses.slice(0, 5);
const warmBook = books.find((book) => book.title === "Reflecting on the Names of Allah") ?? books[0];
const personalSignals = hobbies.map((item) => item.title).join(" / ");
---

<div class="molecular-home">
  <section class="molecular-hero" data-reveal>
    <div class="hero-system">
      <p class="system-kicker">Computational catalysis interface / NIT Srinagar</p>
      <div class="status-line" aria-label="Prototype metadata">
        <span>status: active inquiry</span>
        <span>mode: modelling + molecular insight</span>
        <span>contact: {site.email}</span>
      </div>
      <h1>Catalysis with <span>purpose.</span></h1>
      <p class="hero-copy">
        I am {site.name}, {site.role} in the {site.department}. My work follows
        catalytic pathways from the surface upward, using microkinetic models and
        computational insight to design cleaner chemical processes.
      </p>
      <div class="hero-actions">
        <a href="/research">Open research systems</a>
        <a href="/publications">View outputs</a>
      </div>
    </div>

    <div class="hero-visual" aria-label="Reaction network visual">
      <svg class="network" viewBox="0 0 640 440" role="img" aria-labelledby="network-title">
        <title id="network-title">Abstract reaction network of catalyst pathways</title>
        <defs>
          <linearGradient id="edgeGlow" x1="0" x2="1" y1="0" y2="1">
            <stop stop-color="#59d9cd" />
            <stop offset="1" stop-color="#c98253" />
          </linearGradient>
          <filter id="softGlow">
            <feGaussianBlur stdDeviation="4" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>
        <path class="network-edge edge-a" d="M98 252 C166 184 226 168 294 210 S430 282 532 178" />
        <path class="network-edge edge-b" d="M132 120 C206 146 242 248 326 250 S438 214 562 314" />
        <path class="network-edge edge-c" d="M92 330 C188 330 214 92 338 112 S466 160 570 112" />
        <path class="network-edge edge-d" d="M216 356 C286 290 364 320 428 260 S510 146 574 220" />
        <g filter="url(#softGlow)">
          <circle class="node node-teal" cx="98" cy="252" r="8" />
          <circle class="node node-copper" cx="132" cy="120" r="10" />
          <circle class="node node-green" cx="294" cy="210" r="12" />
          <circle class="node node-teal" cx="326" cy="250" r="7" />
          <circle class="node node-copper" cx="338" cy="112" r="9" />
          <circle class="node node-green" cx="428" cy="260" r="11" />
          <circle class="node node-teal" cx="532" cy="178" r="8" />
          <circle class="node node-copper" cx="562" cy="314" r="10" />
          <circle class="node node-green" cx="570" cy="112" r="7" />
        </g>
      </svg>
      <figure class="portrait-card">
        <Picture
          src={portrait}
          formats={["avif", "webp"]}
          widths={[360, 520, 760]}
          sizes="(max-width: 820px) 74vw, 28vw"
          alt="Portrait of Dr. Fatima Jalid"
          loading="eager"
        />
        <figcaption>
          <span>principal investigator</span>
          <strong>{site.name}</strong>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="system-grid-section" data-reveal>
    <div class="section-console">
      <p>systems under study</p>
      <h2>Surface events, assembled into pathways.</h2>
    </div>
    <div class="system-grid">
      {researchAreas.map((area) => (
        <article class="data-panel">
          <div class="panel-topline">
            <span>{area.number}</span>
            <small>{area.label}</small>
          </div>
          <h3>{area.title}</h3>
          <p>{area.summary}</p>
          <ul>
            {area.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="outputs-section" data-reveal>
    <div class="metrics">
      {publicationStats.map((stat) => (
        <article>
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </article>
      ))}
    </div>
    <article class="latest-output">
      <p class="system-kicker">latest output / journal record</p>
      <h2>{latestPaper?.title}</h2>
      <p>{latestPaper?.authors}</p>
      <a href="/publications">Browse complete publication record</a>
    </article>
  </section>

  <section class="signals-section" data-reveal>
    <div class="section-console">
      <p>selected signals</p>
      <h2>Recent activity log.</h2>
    </div>
    <div class="signal-log">
      {recentNews.map((item) => (
        <article>
          <time>{item.date}</time>
          <div>
            <span>{item.category}</span>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            {item.url && (
              <a href={item.url} target={item.url.startsWith("http") ? "_blank" : undefined} rel={item.url.startsWith("http") ? "noreferrer" : undefined}>
                Open reference
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="teaching-personal" data-reveal>
    <div class="teaching-module">
      <p class="system-kicker">teaching modules</p>
      <h2>Models as ways of thinking clearly.</h2>
      <div class="module-list">
        {teachingModules.map((course) => (
          <article>
            <h3>{course.title}</h3>
            <p>{course.terms.slice(0, 3).join(" / ")}</p>
          </article>
        ))}
      </div>
      <a href="/teaching">Open teaching archive</a>
    </div>

    <aside class="personal-module">
      <p class="system-kicker">personal notes</p>
      <blockquote>
        <span lang="ur" dir="rtl">دنیا کی محفلوں سے اکتا گیا ہوں یا رب</span>
        <small>Dunya ki mehfilon se ukta gaya hun ya Rab</small>
      </blockquote>
      <p>
        The work is computational, but the life around it remains attentive:
        {personalSignals.toLowerCase()}, and books such as <em>{warmBook.title}</em>.
      </p>
      <a href="/personal">Visit the personal corner</a>
    </aside>
  </section>

  <section class="contact-module" data-reveal>
    <p class="system-kicker">contact channel</p>
    <h2>For research, teaching, and thoughtful conversations.</h2>
    <a href={`mailto:${site.email}`}>{site.email}</a>
  </section>
</div>

<style>
  .molecular-home {
    position: relative;
    overflow: hidden;
    padding: clamp(34px, 6vw, 82px) clamp(18px, 4vw, 64px) 72px;
  }
  .molecular-home::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    opacity: 0.24;
    background-image:
      linear-gradient(rgba(89, 217, 205, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(89, 217, 205, 0.08) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: radial-gradient(circle at 50% 20%, black, transparent 70%);
    pointer-events: none;
  }
  .molecular-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.82fr);
    align-items: center;
    min-height: calc(100vh - 138px);
    gap: clamp(36px, 7vw, 100px);
  }
  .system-kicker,
  .status-line,
  .panel-topline,
  .signal-log time,
  .signal-log span,
  .metrics span,
  .hero-actions,
  .molecular-home a {
    font-family: var(--proto-font-mono);
  }
  .system-kicker {
    margin: 0 0 18px;
    color: var(--proto-teal);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .status-line {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }
  .status-line span,
  .hero-actions a,
  .data-panel li,
  .signal-log a,
  .teaching-module > a,
  .personal-module a,
  .contact-module a {
    border: 1px solid rgba(89, 217, 205, 0.22);
    background: rgba(89, 217, 205, 0.06);
    color: var(--proto-teal);
  }
  .status-line span {
    padding: 8px 10px;
    font-size: 0.68rem;
  }
  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }
  h1 {
    max-width: 820px;
    margin-bottom: 24px;
    font-family: var(--proto-font-display);
    font-size: clamp(4rem, 10vw, 9.4rem);
    line-height: 0.86;
    letter-spacing: -0.07em;
  }
  h1 span {
    color: var(--proto-copper);
  }
  .hero-copy {
    max-width: 690px;
    color: var(--proto-muted);
    font-size: clamp(1rem, 1.5vw, 1.22rem);
    line-height: 1.75;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }
  .hero-actions a,
  .signal-log a,
  .teaching-module > a,
  .personal-module a,
  .contact-module a {
    display: inline-flex;
    padding: 12px 14px;
    border-radius: 10px;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .hero-actions a:first-child {
    border-color: rgba(201, 130, 83, 0.38);
    background: rgba(201, 130, 83, 0.12);
    color: #f3b385;
  }
  .hero-visual {
    position: relative;
    min-height: 560px;
  }
  .network {
    position: absolute;
    inset: -48px -38px auto auto;
    width: min(680px, 100%);
    height: auto;
    opacity: 0.82;
  }
  .network-edge {
    fill: none;
    stroke: url(#edgeGlow);
    stroke-linecap: round;
    stroke-width: 1.4;
    stroke-dasharray: 620;
    stroke-dashoffset: 620;
    opacity: 0.58;
    animation: edge-draw 6s ease-in-out infinite alternate;
  }
  .edge-b { animation-delay: 0.8s; }
  .edge-c { animation-delay: 1.4s; }
  .edge-d { animation-delay: 2s; }
  .node { animation: node-pulse 3.6s ease-in-out infinite; }
  .node-teal { fill: var(--proto-teal); }
  .node-copper { fill: var(--proto-copper); animation-delay: 0.6s; }
  .node-green { fill: var(--proto-green); animation-delay: 1.1s; }
  .portrait-card {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(420px, 86%);
    margin: 0;
    padding: 12px;
    border: 1px solid rgba(89, 217, 205, 0.22);
    border-radius: 26px;
    background:
      linear-gradient(135deg, rgba(89, 217, 205, 0.08), rgba(201, 130, 83, 0.08)),
      rgba(7, 11, 14, 0.78);
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.4);
  }
  .portrait-card :global(img) {
    display: block;
    width: 100%;
    max-height: 540px;
    object-fit: cover;
    object-position: center top;
    border-radius: 18px;
    filter: saturate(0.84) contrast(1.06);
  }
  .portrait-card figcaption {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding: 14px 4px 2px;
    color: var(--proto-muted);
    font-family: var(--proto-font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
  }
  .portrait-card strong {
    color: var(--proto-text);
  }
  .system-grid-section,
  .outputs-section,
  .signals-section,
  .teaching-personal,
  .contact-module {
    margin-top: clamp(64px, 10vw, 132px);
  }
  .section-console {
    display: grid;
    grid-template-columns: 0.42fr 1fr;
    gap: 28px;
    margin-bottom: 26px;
    border-top: 1px solid rgba(89, 217, 205, 0.22);
    padding-top: 24px;
  }
  .section-console p {
    color: var(--proto-teal);
    font-family: var(--proto-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .section-console h2,
  .latest-output h2,
  .teaching-module h2,
  .contact-module h2 {
    margin-bottom: 0;
    font-family: var(--proto-font-display);
    font-size: clamp(2.2rem, 5vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.06em;
  }
  .system-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid rgba(89, 217, 205, 0.18);
  }
  .data-panel {
    position: relative;
    min-height: 320px;
    padding: 24px;
    border-right: 1px solid rgba(89, 217, 205, 0.18);
    background:
      radial-gradient(circle at 20% 0%, rgba(89, 217, 205, 0.12), transparent 13rem),
      var(--proto-panel);
    overflow: hidden;
  }
  .data-panel:last-child {
    border-right: 0;
  }
  .data-panel::after,
  .latest-output::after,
  .personal-module::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.12;
    background-image:
      linear-gradient(30deg, transparent 0 42%, rgba(89, 217, 205, 0.52) 42% 43%, transparent 43% 100%),
      linear-gradient(150deg, transparent 0 42%, rgba(201, 130, 83, 0.44) 42% 43%, transparent 43% 100%);
    background-size: 38px 38px;
    pointer-events: none;
  }
  .panel-topline {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    color: var(--proto-muted);
    font-size: 0.68rem;
    text-transform: uppercase;
  }
  .panel-topline span {
    color: var(--proto-copper);
  }
  .data-panel h3,
  .signal-log h3,
  .module-list h3 {
    margin: 58px 0 12px;
    font-family: var(--proto-font-display);
    font-size: 1.35rem;
    line-height: 1.1;
  }
  .data-panel p,
  .signal-log p,
  .module-list p,
  .latest-output p,
  .personal-module p {
    color: var(--proto-muted);
    line-height: 1.65;
  }
  .data-panel ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .data-panel li {
    padding: 6px 8px;
    border-radius: 999px;
    font-size: 0.62rem;
  }
  .outputs-section {
    display: grid;
    grid-template-columns: minmax(260px, 0.65fr) minmax(0, 1.35fr);
    gap: 18px;
  }
  .metrics {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .metrics article,
  .latest-output,
  .teaching-module,
  .personal-module,
  .contact-module {
    position: relative;
    border: 1px solid rgba(89, 217, 205, 0.18);
    background: var(--proto-panel);
  }
  .metrics article {
    padding: 24px;
  }
  .metrics strong {
    display: block;
    color: var(--proto-green);
    font-family: var(--proto-font-display);
    font-size: 4rem;
    line-height: 0.9;
  }
  .metrics span {
    color: var(--proto-muted);
    font-size: 0.68rem;
    text-transform: uppercase;
  }
  .latest-output {
    padding: clamp(28px, 5vw, 56px);
    overflow: hidden;
  }
  .latest-output h2 {
    position: relative;
    z-index: 1;
    max-width: 980px;
  }
  .latest-output a {
    position: relative;
    z-index: 1;
    color: var(--proto-copper);
    font-family: var(--proto-font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
  }
  .signal-log {
    border-top: 1px solid rgba(89, 217, 205, 0.2);
  }
  .signal-log article {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 28px;
    padding: 24px 0;
    border-bottom: 1px solid rgba(89, 217, 205, 0.16);
  }
  .signal-log time {
    color: var(--proto-copper);
    font-size: 1.05rem;
  }
  .signal-log h3 {
    margin: 4px 0 8px;
  }
  .signal-log span {
    color: var(--proto-teal);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .signal-log a {
    margin-top: 8px;
  }
  .teaching-personal {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
    gap: 18px;
  }
  .teaching-module,
  .personal-module,
  .contact-module {
    padding: clamp(28px, 4vw, 48px);
  }
  .module-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 34px 0;
  }
  .module-list article {
    padding: 16px;
    border: 1px solid rgba(89, 217, 205, 0.16);
    background: rgba(255, 255, 255, 0.02);
  }
  .module-list h3 {
    margin: 0 0 12px;
    font-size: 1rem;
  }
  .personal-module {
    overflow: hidden;
    background:
      radial-gradient(circle at 80% 12%, rgba(201, 130, 83, 0.16), transparent 16rem),
      rgba(23, 17, 14, 0.72);
  }
  .personal-module blockquote {
    position: relative;
    z-index: 1;
    margin: 18px 0 30px;
    padding: 0;
  }
  .personal-module blockquote span {
    display: block;
    color: #ffe2bf;
    font-family: var(--proto-font-urdu);
    font-size: clamp(1.45rem, 2.6vw, 2.1rem);
    line-height: 2.2;
  }
  .personal-module blockquote small {
    color: var(--proto-copper);
    font-family: var(--proto-font-serif);
    font-size: 1.05rem;
  }
  .personal-module em {
    color: #ffe2bf;
    font-style: normal;
  }
  .contact-module {
    text-align: center;
  }
  .contact-module h2 {
    max-width: 880px;
    margin: 0 auto 24px;
  }
  .contact-module a {
    border-color: rgba(201, 130, 83, 0.38);
    background: rgba(201, 130, 83, 0.12);
    color: #f3b385;
  }
  @keyframes edge-draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes node-pulse {
    0%, 100% { opacity: 0.68; transform: scale(1); transform-origin: center; }
    50% { opacity: 1; transform: scale(1.4); transform-origin: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .network-edge {
      stroke-dashoffset: 0;
      animation: none;
    }
    .node {
      animation: none;
    }
  }
  @media (max-width: 1100px) {
    .molecular-hero,
    .outputs-section,
    .teaching-personal {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      min-height: 520px;
    }
    .system-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .data-panel:nth-child(2) {
      border-right: 0;
    }
  }
  @media (max-width: 680px) {
    .molecular-home {
      padding-inline: 16px;
    }
    .status-line span {
      width: 100%;
    }
    h1 {
      font-size: clamp(3.6rem, 18vw, 5.8rem);
    }
    .hero-visual {
      min-height: 440px;
    }
    .portrait-card {
      width: 100%;
    }
    .system-grid,
    .module-list {
      grid-template-columns: 1fr;
    }
    .data-panel {
      border-right: 0;
      border-bottom: 1px solid rgba(89, 217, 205, 0.18);
    }
    .data-panel:last-child {
      border-bottom: 0;
    }
    .section-console,
    .signal-log article {
      grid-template-columns: 1fr;
    }
    .signal-log article {
      gap: 8px;
    }
  }
</style>
