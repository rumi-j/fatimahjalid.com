---
import { Picture } from "astro:assets";
import { researchAreas } from "../../data/research";
import { publications } from "../../data/publications";
import { accomplishments } from "../../data/professional";
import { news } from "../../data/news";
import { site } from "../../data/site";
import portrait from "../../assets/fatima-jalid-portrait.jpg";

const latestPaper = [...publications]
  .filter((item) => item.type === "journal")
  .sort((a, b) => b.year - a.year)[0];
const selectedAccomplishments = [...accomplishments]
  .sort((a, b) => Number(b.year) - Number(a.year))
  .slice(0, 4);
const selectedNews = [...news].sort((a, b) => b.year - a.year).slice(0, 3);
---

<div class="mihrab-home">
  <section class="portal-hero" data-reveal>
    <div class="portal-copy">
      <p class="inscription">Learner on the path of God</p>
      <h1>{site.name}</h1>
      <p class="role-line">
        {site.role} / {site.department} / {site.institute}
      </p>
      <p class="portal-lede">
        Catalysis with purpose: a scholarly practice of modelling surface events,
        tracing pathways, and asking how chemical engineering can serve cleaner futures.
      </p>
    </div>
    <figure class="mihrab-portrait">
      <div class="arch-frame">
        <Picture
          src={portrait}
          formats={["avif", "webp"]}
          widths={[360, 520, 760]}
          sizes="(max-width: 820px) 76vw, 28vw"
          alt="Portrait of Dr. Fatima Jalid"
          loading="eager"
        />
      </div>
      <figcaption>
        <span>fatimahjalid</span>
        <strong>Chemical Engineering / NIT Srinagar</strong>
      </figcaption>
    </figure>
    <div class="frieze" aria-label="Research keywords">
      {researchAreas.map((area) => <span>{area.title}</span>)}
    </div>
  </section>

  <section class="tile-band" data-reveal>
    <div class="girih-mark" aria-hidden="true">
      <svg viewBox="0 0 180 180">
        <path d="M90 8 116 64 172 90 116 116 90 172 64 116 8 90 64 64Z" />
        <path d="M90 36 128 52 144 90 128 128 90 144 52 128 36 90 52 52Z" />
        <path d="M8 90h164M90 8v164M36 36l108 108M144 36 36 144" />
      </svg>
    </div>
    {researchAreas.map((area) => (
      <article>
        <span>{area.number}</span>
        <h2>{area.title}</h2>
        <p>{area.summary}</p>
      </article>
    ))}
  </section>

  <section class="manuscript-spread" data-reveal>
    <article class="manuscript-panel">
      <p class="folio">folio 01 / research practice</p>
      <h2>Working between molecular detail and responsibility.</h2>
      <p>
        Models are treated here as disciplined attention: a way to connect energetics,
        pathways, deactivation, and design choices without losing sight of purpose.
      </p>
      <a href="/research">Read the research profile</a>
    </article>
    <article class="manuscript-panel iqbal-panel">
      <p class="folio">Iqbal / approved text</p>
      <blockquote>
        <span lang="ur" dir="rtl">
          صنوبر باغ میں آزاد بھی ہے، پا بہ گل بھی ہے<br />
          انہی پابندیوں میں حاصل آزادی کو تو کر لے
        </span>
        <small>
          Sanobar bagh mein azad bhi hai, pa-ba-gil bhi hai<br />
          Inhi pabandiyon mein hasil-e-azadi ko tu kar le
        </small>
      </blockquote>
      <p>
        A reminder that freedom is not always the absence of constraint; sometimes
        it is something we learn to find within it.
      </p>
    </article>
  </section>

  <section class="scholarly-record" data-reveal>
    <div class="record-heading">
      <p class="inscription">selected academic signals</p>
      <h2>Milestones arranged as marginalia.</h2>
    </div>
    <div class="record-grid">
      {selectedAccomplishments.map((item) => (
        <article>
          <time>{item.year}</time>
          <h3>{item.title}</h3>
          <p>{item.summary}</p>
          {item.url && <a href={item.url} target={item.url.startsWith("http") ? "_blank" : undefined} rel={item.url.startsWith("http") ? "noreferrer" : undefined}>Open reference</a>}
        </article>
      ))}
    </div>
  </section>

  <section class="paper-and-news" data-reveal>
    <article class="latest-paper">
      <p class="folio">latest publication</p>
      <h2>{latestPaper?.title}</h2>
      <p>{latestPaper?.venue}</p>
      <a href="/publications">Open publications</a>
    </article>
    <div class="news-scroll">
      <p class="folio">recent notes</p>
      {selectedNews.map((item) => (
        <article>
          <span>{item.date}</span>
          <h3>{item.title}</h3>
          <p>{item.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mihrab-contact" data-reveal>
    <p class="inscription">contact</p>
    <h2>For students, collaborators, and careful questions.</h2>
    <a href={`mailto:${site.email}`}>{site.email}</a>
  </section>
</div>

<style>
  .mihrab-home {
    position: relative;
    overflow: hidden;
    padding: clamp(34px, 6vw, 80px) clamp(18px, 4vw, 64px) 76px;
  }
  .mihrab-home::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    opacity: 0.18;
    background-image:
      linear-gradient(45deg, transparent 0 46%, rgba(186, 143, 45, 0.55) 46% 47%, transparent 47%),
      linear-gradient(-45deg, transparent 0 46%, rgba(29, 80, 108, 0.42) 46% 47%, transparent 47%);
    background-size: 72px 72px;
    mask-image: radial-gradient(circle at 50% 16%, black, transparent 78%);
    pointer-events: none;
  }
  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }
  .portal-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(340px, 0.62fr);
    gap: clamp(38px, 7vw, 96px);
    align-items: center;
    min-height: calc(100vh - 142px);
    padding: clamp(30px, 5vw, 72px);
    border: 1px solid rgba(186, 143, 45, 0.42);
    background:
      linear-gradient(90deg, rgba(255, 248, 235, 0.72), rgba(255, 248, 235, 0.42)),
      var(--proto-panel);
  }
  .portal-hero::before,
  .portal-hero::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }
  .portal-hero::before {
    inset: 18px;
    border: 1px solid rgba(29, 80, 108, 0.2);
  }
  .portal-hero::after {
    left: 50%;
    top: 18px;
    width: min(360px, 44vw);
    height: min(520px, 70vh);
    transform: translateX(-50%);
    border: 1px solid rgba(186, 143, 45, 0.28);
    border-radius: 999px 999px 12px 12px;
    opacity: 0.6;
  }
  .inscription,
  .folio,
  .role-line,
  .frieze,
  .mihrab-contact a,
  .record-grid a,
  .latest-paper a {
    font-family: var(--proto-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .inscription,
  .folio {
    color: var(--proto-rust);
    font-size: 0.72rem;
  }
  h1 {
    max-width: 900px;
    margin-bottom: 20px;
    color: var(--proto-text);
    font-family: var(--proto-font-serif);
    font-size: clamp(4.6rem, 11vw, 11rem);
    font-weight: 400;
    line-height: 0.84;
    letter-spacing: -0.07em;
  }
  .role-line {
    color: var(--proto-lapis);
    font-size: 0.74rem;
    line-height: 1.7;
  }
  .portal-lede {
    max-width: 660px;
    color: var(--proto-muted);
    font-size: clamp(1.04rem, 1.5vw, 1.24rem);
    line-height: 1.8;
  }
  .mihrab-portrait {
    position: relative;
    z-index: 1;
    margin: 0;
  }
  .arch-frame {
    position: relative;
    padding: 16px 16px 0;
    border: 1px solid rgba(170, 96, 71, 0.5);
    border-radius: 220px 220px 14px 14px;
    background:
      radial-gradient(circle at 50% 0%, rgba(186, 143, 45, 0.22), transparent 18rem),
      rgba(255, 250, 239, 0.74);
    box-shadow:
      inset 0 0 0 7px rgba(186, 143, 45, 0.13),
      0 28px 80px rgba(48, 74, 64, 0.16);
  }
  .arch-frame::before {
    content: "";
    position: absolute;
    inset: 8px 8px 0;
    border: 1px solid rgba(186, 143, 45, 0.7);
    border-radius: 210px 210px 10px 10px;
    pointer-events: none;
  }
  .arch-frame :global(img) {
    display: block;
    width: 100%;
    max-height: 560px;
    object-fit: cover;
    object-position: center top;
    border-radius: 190px 190px 8px 8px;
  }
  .mihrab-portrait figcaption {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding-top: 16px;
    color: var(--proto-muted);
    font-family: var(--proto-font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
  }
  .mihrab-portrait strong {
    color: var(--proto-text);
  }
  .frieze {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgba(186, 143, 45, 0.4);
    background: rgba(23, 59, 50, 0.94);
    color: #fff8eb;
    font-size: 0.7rem;
  }
  .frieze span {
    padding: 14px 12px;
    border-right: 1px solid rgba(255, 248, 235, 0.18);
    text-align: center;
  }
  .frieze span:last-child {
    border-right: 0;
  }
  .tile-band,
  .manuscript-spread,
  .scholarly-record,
  .paper-and-news,
  .mihrab-contact {
    margin-top: clamp(64px, 10vw, 132px);
  }
  .tile-band {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid rgba(48, 74, 64, 0.18);
    background: rgba(255, 248, 235, 0.54);
  }
  .girih-mark {
    position: absolute;
    inset: auto 18px calc(100% - 36px) auto;
    width: 104px;
    color: var(--proto-gold);
  }
  .girih-mark svg {
    display: block;
    width: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  .tile-band article {
    min-height: 280px;
    padding: 30px 24px;
    border-right: 1px solid rgba(48, 74, 64, 0.18);
  }
  .tile-band article:last-child {
    border-right: 0;
  }
  .tile-band span,
  .record-grid time {
    color: var(--proto-rust);
    font-family: var(--proto-font-serif);
    font-size: 2rem;
  }
  .tile-band h2,
  .manuscript-panel h2,
  .record-heading h2,
  .latest-paper h2,
  .mihrab-contact h2 {
    font-family: var(--proto-font-serif);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }
  .tile-band h2 {
    margin: 56px 0 12px;
    font-size: 2rem;
  }
  .tile-band p,
  .manuscript-panel p,
  .record-grid p,
  .latest-paper p,
  .news-scroll p {
    color: var(--proto-muted);
    line-height: 1.72;
  }
  .manuscript-spread {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 18px;
  }
  .manuscript-panel,
  .latest-paper,
  .news-scroll,
  .mihrab-contact {
    position: relative;
    border: 1px solid rgba(186, 143, 45, 0.42);
    background: var(--proto-panel);
    box-shadow: inset 0 0 0 6px rgba(186, 143, 45, 0.08);
  }
  .manuscript-panel {
    padding: clamp(30px, 5vw, 58px);
  }
  .manuscript-panel::before,
  .latest-paper::before,
  .news-scroll::before {
    content: "";
    position: absolute;
    top: 18px;
    bottom: 18px;
    left: 20px;
    width: 1px;
    background: rgba(170, 96, 71, 0.3);
  }
  .manuscript-panel h2,
  .record-heading h2,
  .latest-paper h2,
  .mihrab-contact h2 {
    max-width: 900px;
    font-size: clamp(2.4rem, 5.4vw, 5.6rem);
  }
  .manuscript-panel a,
  .record-grid a,
  .latest-paper a,
  .mihrab-contact a {
    color: var(--proto-lapis);
    font-size: 0.72rem;
  }
  .iqbal-panel blockquote {
    margin: 26px 0;
  }
  .iqbal-panel blockquote span {
    display: block;
    color: var(--proto-text);
    font-family: var(--proto-font-urdu);
    font-size: clamp(1.55rem, 2.6vw, 2.3rem);
    line-height: 2.35;
  }
  .iqbal-panel blockquote small {
    display: block;
    margin-top: 16px;
    color: var(--proto-rust);
    font-family: var(--proto-font-serif);
    font-size: 1.08rem;
    line-height: 1.7;
  }
  .record-heading {
    display: grid;
    grid-template-columns: 0.34fr 1fr;
    gap: 24px;
    align-items: end;
    margin-bottom: 28px;
    border-bottom: 1px solid rgba(48, 74, 64, 0.16);
    padding-bottom: 24px;
  }
  .record-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .record-grid article {
    padding: 22px;
    border: 1px solid rgba(48, 74, 64, 0.16);
    background: rgba(255, 248, 235, 0.56);
  }
  .record-grid h3,
  .news-scroll h3 {
    margin: 28px 0 10px;
    font-family: var(--proto-font-serif);
    font-size: 1.36rem;
    font-weight: 400;
    line-height: 1.12;
  }
  .paper-and-news {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    gap: 18px;
  }
  .latest-paper,
  .news-scroll,
  .mihrab-contact {
    padding: clamp(30px, 5vw, 58px);
  }
  .news-scroll article {
    border-top: 1px solid rgba(48, 74, 64, 0.16);
    padding-top: 18px;
  }
  .news-scroll span {
    color: var(--proto-rust);
    font-family: var(--proto-font-mono);
    font-size: 0.75rem;
  }
  .mihrab-contact {
    text-align: center;
  }
  .mihrab-contact h2 {
    margin-right: auto;
    margin-left: auto;
  }
  .mihrab-contact a {
    display: inline-flex;
    margin-top: 18px;
    padding: 12px 18px;
    border: 1px solid rgba(29, 80, 108, 0.28);
    border-radius: 999px;
    background: rgba(29, 80, 108, 0.08);
  }
  @media (max-width: 1100px) {
    .portal-hero,
    .manuscript-spread,
    .paper-and-news {
      grid-template-columns: 1fr;
    }
    .portal-hero {
      padding-bottom: 90px;
    }
    .tile-band,
    .record-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tile-band article:nth-child(3) {
      border-right: 0;
    }
  }
  @media (max-width: 700px) {
    .mihrab-home {
      padding-inline: 16px;
    }
    h1 {
      font-size: clamp(4.2rem, 18vw, 6.5rem);
    }
    .portal-hero {
      padding: 28px 22px 128px;
    }
    .frieze,
    .tile-band,
    .record-grid,
    .record-heading {
      grid-template-columns: 1fr;
    }
    .frieze span,
    .tile-band article {
      border-right: 0;
      border-bottom: 1px solid rgba(255, 248, 235, 0.16);
    }
    .tile-band article {
      border-bottom-color: rgba(48, 74, 64, 0.18);
    }
    .frieze span:last-child,
    .tile-band article:last-child {
      border-bottom: 0;
    }
    .mihrab-portrait figcaption {
      flex-direction: column;
    }
  }
</style>
