---
// Dev-only design-direction switcher. Rendered from BaseLayout behind import.meta.env.DEV,
// so it is stripped from production builds. Sets data-theme on <html>; theme CSS lives in
// src/styles/themes.css scoped by [data-theme="..."].
const themes = [
  { id: "editorial", label: "Editorial" },
  { id: "mihrab", label: "Mihrab" },
  { id: "modern", label: "Modern" },
];
---

<div class="theme-switcher" aria-label="Design direction (dev only)">
  <span>Direction</span>
  {themes.map((t) => <button type="button" data-theme-id={t.id}>{t.label}</button>)}
</div>

<style>
  .theme-switcher {
    position: fixed;
    z-index: 101;
    bottom: 64px;
    left: 16px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    border-radius: 12px;
    background: rgba(15, 43, 38, 0.92);
    color: #fbf8f0;
    font-family: system-ui, sans-serif;
    font-size: 11px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(8px);
  }
  .theme-switcher span { opacity: 0.7; letter-spacing: 0.08em; text-transform: uppercase; }
  .theme-switcher button {
    padding: 5px 9px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
  }
  .theme-switcher button.active { background: #deb75d; border-color: #deb75d; color: #173b32; }
</style>

<script>
  const KEY = "dev-theme";
  const root = document.documentElement;
  const btns = document.querySelectorAll<HTMLButtonElement>(".theme-switcher button");

  const apply = (id: string) => {
    root.dataset.theme = id;
    btns.forEach((b) => b.classList.toggle("active", b.dataset.themeId === id));
    localStorage.setItem(KEY, id);
  };

  btns.forEach((b) => b.addEventListener("click", () => apply(b.dataset.themeId ?? "editorial")));
  apply(localStorage.getItem(KEY) ?? "editorial");
</script>
