---
// Mihrab pointed-arch double frame (rust outer + gold inset). The content is
// never clipped — the arch is ornament around it.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["arch-frame", className]}>
  <slot />
</div>

<style>
  .arch-frame {
    position: relative;
    padding: 16px 16px 0;
    border: 1px solid rgba(178, 84, 56, 0.5);
    border-radius: 220px 220px 14px 14px;
    background:
      radial-gradient(circle at 50% 0%, rgba(184, 137, 46, 0.2), transparent 18rem),
      rgba(255, 250, 239, 0.74);
    box-shadow:
      inset 0 0 0 7px rgba(184, 137, 46, 0.13),
      0 28px 80px rgba(48, 74, 64, 0.16);
  }
  .arch-frame::before {
    content: "";
    position: absolute;
    inset: 8px 8px 0;
    border: 1px solid rgba(184, 137, 46, 0.7);
    border-radius: 210px 210px 10px 10px;
    pointer-events: none;
  }
  .arch-frame :global(img) {
    display: block;
    width: 100%;
    border-radius: 196px 196px 6px 6px;
    object-fit: cover;
    object-position: center top;
  }
</style>
